{
  "manifest_version": 3,
  "name": "BOSS 消息助手 v3",
  "version": "0.3.0",
  "description": "v3：失败不中断任务、跳过当前会话；切完会话等聊天内容加载后再写消息。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.zhipin.com/web/geek/chat*"],
  "action": {
    "default_title": "BOSS 消息助手 v3",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/web/geek/chat*"],
      "js": ["shared.js", "conversation-heuristics.js", "conversation-target.js", "conversation-scroll-target.js", "collection-scroll.js", "send-confirmation.js", "audit-tree.js", "audit-report.js", "editor-target.js", "editor-write.js", "message-container-target.js", "message-state.js", "send-command.js", "task-runner.js", "selectors.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
